# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Site URL (важно: точный домен без слеша, используется в OAuth callback и YooKassa) ===
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# === Яндекс GPT (AI-функции) ===
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# === Resend (транзакционные письма) ===
RESEND_API_KEY=

# === YooKassa (заполнить когда подключите) ===
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
